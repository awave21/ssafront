{
	email {$ACME_EMAIL}
}

chatmedbot.ru {
	encode zstd gzip

	@lkPaths path /login /login/* /dashboard /dashboard/* /agents /agents/* /settings /settings/*
	redir @lkPaths https://lk.chatmedbot.ru{uri} permanent

	handle {
		reverse_proxy landing:80
	}
}

api.chatmedbot.ru {
	encode zstd gzip

	@docs path /docs* /redoc* /openapi.json
	basic_auth @docs {
		{$DOCS_AUTH_USER} {$DOCS_AUTH_HASH}
	}

	reverse_proxy api:8000
}

lk.chatmedbot.ru {
	handle_path {$MONITOR_PATH}* {
		basic_auth {
			{$MONITOR_AUTH_USER} {$MONITOR_AUTH_HASH}
		}
		encode zstd gzip
		reverse_proxy netdata:19999
	}

	# SSE-стрим (чат навыка) — БЕЗ сжатия, иначе Caddy буферизует поток
	# и дельты приходят пачкой в конце вместо реального времени.
	@sse path */skill-chat/stream
	handle @sse {
		reverse_proxy api:8000
	}

	@apiPath path /api/v1/*
	handle @apiPath {
		encode zstd gzip
		reverse_proxy api:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:80
	}
}
